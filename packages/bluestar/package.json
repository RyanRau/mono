{
  "name": "bluestar",
  "version": "1.6.0",
  "description": "(Ozark) Bluestar a react component library",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run typecheck && tsup",
    "prepare": "npm run build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "typecheck": "tsc -p tsconfig.typecheck.json"
  },
  "license": "ISC",
  "peerDependencies": {
    "goober": "^2.1.19",
    "react": "^18 || ^19"
  },
  "devDependencies": {
    "@storybook/react": "10.6.5",
    "@storybook/react-vite": "10.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "goober": "^2.1.19",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "10.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  }
}
